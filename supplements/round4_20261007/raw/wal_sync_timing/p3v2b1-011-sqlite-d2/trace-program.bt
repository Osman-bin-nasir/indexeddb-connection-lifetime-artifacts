// Instantiated per fresh overlay with the discovered Chromium process tree.
// Line format (space separated): KIND NSECS PID TID PROBE FD COMM [COUNT]
//   KIND  W = write/pwrite64        (count = request bytes)
//         V = writev/pwritev        (count = iovec length; no byte count exists at
//                                    sys_enter, so the byte total is not claimed)
//         S = fsync / fdatasync
//         R = sync_file_range
//         M = msync (no descriptor; fd printed as -1)
//
// PID here is the thread-group id, so one predicate covers every browser thread.
// The write family is split in two blocks because `count` is not a member of the
// writev/pwritev tracepoints (`vlen` is), and bpftrace validates members per probe.

tracepoint:syscalls:sys_enter_write,
tracepoint:syscalls:sys_enter_pwrite64
/pid == 1730 || pid == 1737 || pid == 1738 || pid == 1759 || pid == 1769 || pid == 1809 || pid == 1818 || pid == 1820 || pid == 1877/
{
  printf("W %llu %d %d %s %d %s %llu\n", nsecs, pid, tid, probe, args->fd, comm, args->count);
}

tracepoint:syscalls:sys_enter_writev,
tracepoint:syscalls:sys_enter_pwritev
/pid == 1730 || pid == 1737 || pid == 1738 || pid == 1759 || pid == 1769 || pid == 1809 || pid == 1818 || pid == 1820 || pid == 1877/
{
  printf("V %llu %d %d %s %d %s %llu\n", nsecs, pid, tid, probe, args->fd, comm, args->vlen);
}

tracepoint:syscalls:sys_enter_fsync,
tracepoint:syscalls:sys_enter_fdatasync
/pid == 1730 || pid == 1737 || pid == 1738 || pid == 1759 || pid == 1769 || pid == 1809 || pid == 1818 || pid == 1820 || pid == 1877/
{
  printf("S %llu %d %d %s %d %s\n", nsecs, pid, tid, probe, args->fd, comm);
}

tracepoint:syscalls:sys_enter_sync_file_range
/pid == 1730 || pid == 1737 || pid == 1738 || pid == 1759 || pid == 1769 || pid == 1809 || pid == 1818 || pid == 1820 || pid == 1877/
{
  printf("R %llu %d %d %s %d %s\n", nsecs, pid, tid, probe, args->fd, comm);
}

tracepoint:syscalls:sys_enter_msync
/pid == 1730 || pid == 1737 || pid == 1738 || pid == 1759 || pid == 1769 || pid == 1809 || pid == 1818 || pid == 1820 || pid == 1877/
{
  printf("M %llu %d %d %s -1 %s\n", nsecs, pid, tid, probe, comm);
}
